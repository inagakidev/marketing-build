# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local development: the Postgres from docker-compose.yml (`docker compose up -d`).
# To move to Supabase, replace only this line with the project's connection
# string (Settings > Database > Connection string > URI). Nothing else changes.
DATABASE_URL="postgresql://briefing:briefing@localhost:5432/briefing?schema=public"

# ---------------------------------------------------------------------------
# Supabase Auth
# ---------------------------------------------------------------------------
# Settings > API. The anon key is public (it goes to the browser); the service
# role key must NEVER be exposed to the client — it's used only on the server:
# by the seed to create the administrator, and when an invitation is accepted
# to create the invitee's login account (EP-04.4).
NEXT_PUBLIC_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sua-anon-key"
SUPABASE_SERVICE_ROLE_KEY="sua-service-role-key"

# ---------------------------------------------------------------------------
# Administrator (used by the seed to create the panel user)
# ---------------------------------------------------------------------------
ADMIN_NAME="Nome da Administradora"
ADMIN_EMAIL="admin@exemplo.com"
ADMIN_PASSWORD="troque-esta-senha"

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Public base URL used to build the briefing link and for Playwright to
# navigate to the print page when generating the PDF.
# Required in production; in development the default is http://localhost:3000.
# The server does NOT start with an invalid environment (src/server/env.ts).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Default validity (in days) of a newly created briefing link. Between 1 and 365.
BRIEFING_LINK_TTL_DAYS="30"

# ---------------------------------------------------------------------------
# Development
# ---------------------------------------------------------------------------
# Panel access without login, to work before having Supabase credentials.
# Only works with NODE_ENV=development AND Supabase not configured; as soon as
# NEXT_PUBLIC_SUPABASE_URL is filled in, it's ignored.
# Leave empty to always require login.
DEV_ADMIN_EMAIL=""

# An already installed Chromium, for distros `playwright install` doesn't recognize.
# Only applies outside serverless; on Vercel the PDF uses @sparticuz/chromium.
CHROMIUM_EXECUTABLE_PATH=""
