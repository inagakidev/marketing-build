# ---------------------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------------------
# Desenvolvimento local: Postgres do docker-compose.yml (`docker compose up -d`).
# Para migrar ao Supabase, troque apenas esta linha pela connection string do
# projeto (Settings > Database > Connection string > URI). Nada mais muda.
DATABASE_URL="postgresql://briefing:briefing@localhost:5432/briefing?schema=public"

# ---------------------------------------------------------------------------
# Supabase Auth
# ---------------------------------------------------------------------------
# Settings > API. A anon key é pública (vai para o browser); a service role key
# NUNCA pode ser exposta ao cliente — é usada só no servidor, para criar o
# usuário administrador no seed.
NEXT_PUBLIC_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sua-anon-key"
SUPABASE_SERVICE_ROLE_KEY="sua-service-role-key"

# ---------------------------------------------------------------------------
# Administradora (usada pelo seed para criar o único usuário do MVP)
# ---------------------------------------------------------------------------
ADMIN_NAME="Nome da Administradora"
ADMIN_EMAIL="admin@exemplo.com"
ADMIN_PASSWORD="troque-esta-senha"

# ---------------------------------------------------------------------------
# Aplicação
# ---------------------------------------------------------------------------
# Base pública usada para montar o link do briefing e para o Playwright
# navegar até a página de impressão na geração do PDF.
# Obrigatória em produção; em desenvolvimento o padrão é http://localhost:3000.
# O servidor NÃO sobe com ambiente inválido (src/server/env.ts).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Validade padrão (em dias) de um link de briefing recém-criado. Entre 1 e 365.
BRIEFING_LINK_TTL_DAYS="30"

# ---------------------------------------------------------------------------
# Desenvolvimento
# ---------------------------------------------------------------------------
# Acesso ao painel sem login, para trabalhar antes de ter as credenciais do
# Supabase. Só funciona com NODE_ENV=development E Supabase não configurado;
# assim que NEXT_PUBLIC_SUPABASE_URL for preenchida, é ignorado.
# Deixe vazio para exigir login sempre.
DEV_ADMIN_EMAIL=""

# Chromium já instalado, para distribuições que o `playwright install` não reconhece.
CHROMIUM_EXECUTABLE_PATH=""
