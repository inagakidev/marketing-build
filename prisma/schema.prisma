// Briefing Inteligente — database schema
//
// Conventions:
// - Enums in snake_case to match the values used by the rules engine
//   (src/core), which is database-agnostic and works with plain strings.
// - `Question` is a GLOBAL catalog: it isn't duplicated per briefing. The
//   link to a briefing goes through `Answer`.
// - Visibility rules and options live in Json columns, not in code, so
//   questions can be added/edited without a deploy.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// The connection string lives in prisma.config.ts (a Prisma 7 requirement):
// the schema only declares the provider.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum BriefingStatus {
  draft
  awaiting_response
  in_progress
  submitted
  ready_for_review
  approved
}

enum BusinessType {
  local_business
  ecommerce
  info_product
  freelancer
  b2b_service
  other
}

/// A question's category. Defines the grouping into blocks in the public
/// form. Maps to DiagnosisCategory in src/core/diagnosis/categoryMap.ts.
enum QuestionCategory {
  business
  goals
  audience
  brand
  competition
  digital_presence
  offer
  closing
}

enum AnswerType {
  short_text
  long_text
  single_choice
  multi_choice
}

enum SignalSeverity {
  light
  moderate
  strong
}

/// Category evaluated in the diagnosis. A set distinct from QuestionCategory:
/// several question categories feed a single diagnosis category.
enum DiagnosisCategory {
  positioning
  audience
  offer
  digital_presence
  current_marketing
}

enum DiagnosisStatus {
  green
  yellow
  red
  gray
}

/// One role per member per organization (D9). Permissions per role are the
/// matrix in docs/REQUIREMENTS.md §2.3.
enum MembershipRole {
  admin
  leader
  member
}

/// Deactivating keeps the row, so authorship and history survive (AUTH-12).
enum MembershipStatus {
  active
  deactivated
}

// ---------------------------------------------------------------------------
// Modelos
// ---------------------------------------------------------------------------

/// A panel user. Access to an organization comes from a Membership, not from
/// this record alone.
/// The password lives in Supabase Auth; only the link is stored here.
model User {
  id             String   @id @default(cuid())
  supabaseAuthId String   @unique
  name           String
  email          String   @unique
  createdAt      DateTime @default(now())

  clients             Client[]
  memberships         Membership[]
  invitationsSent     Invitation[] @relation("InvitationInvitedBy")
  invitationsAccepted Invitation[] @relation("InvitationAcceptedBy")
  auditEvents         AuditEvent[]

  @@map("users")
}

/// Tenant and data isolation boundary (ORG-01, ORG-02).
model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  invitations Invitation[]
  auditEvents AuditEvent[]

  @@map("organizations")
}

/// A user's place in an organization (AUTH-03). The schema allows several
/// organizations per user (ORG-02); V1 keeps one per person in application
/// code (D13).
///
/// `onDelete: Restrict` on both sides: removing a member is a deactivation,
/// never a delete that would erase who did what (AUTH-11, AUTH-12).
model Membership {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           MembershipRole
  status         MembershipStatus @default(active)
  deactivatedAt  DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("memberships")
}

/// A link that lets someone join an organization with a given role (D12).
///
/// Only the token's hash is stored: the link is the credential, so a leaked
/// table must not leak usable links. Pending = not accepted, not revoked and
/// not expired.
model Invitation {
  id             String         @id @default(cuid())
  organizationId String
  email          String
  role           MembershipRole
  tokenHash      String         @unique
  expiresAt      DateTime
  invitedById    String
  acceptedAt     DateTime?
  acceptedById   String?
  revokedAt      DateTime?
  createdAt      DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invitedBy    User         @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptedBy   User?        @relation("InvitationAcceptedBy", fields: [acceptedById], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([email])
  @@map("invitations")
}

/// Security and accountability trail (AUD-01, ARCHITECTURE §12.2).
///
/// Append-only. `metadata` holds the minimum needed to understand the change
/// (e.g. old and new role) and never personal content such as emails or
/// free-text answers.
model AuditEvent {
  id             String   @id @default(cuid())
  organizationId String
  /// Null for actions without a signed-in actor, e.g. a migration.
  actorId        String?
  entityType     String
  entityId       String
  action         String
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor        User?        @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_events")
}

/// The admin's client.
model Client {
  id            String   @id @default(cuid())
  userId        String
  name          String
  contactEmail  String
  phone         String?
  projectType   String?
  internalNotes String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  briefings Briefing[]

  @@index([userId])
  @@map("clients")
}

/// A collection instance for a Client. A client can have several.
model Briefing {
  id     String         @id @default(cuid())
  status BriefingStatus @default(draft)

  clientId String

  /// Public link token. Opaque and unpredictable — it's the respondent's only
  /// credential, so never derive it from an id/name.
  token String @unique

  /// Mirrors the answer to the branching question (`business_type`).
  /// Denormalized on purpose: the visibility engine needs it on every
  /// evaluation, and the panel filters by it.
  businessType BusinessType?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  expiresAt   DateTime?
  submittedAt DateTime?

  client    Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  answers   Answer[]
  signals   Signal[]
  diagnoses Diagnosis[]

  @@index([clientId])
  @@index([status])
  @@map("briefings")
}

/// Global question catalog.
model Question {
  id String @id @default(cuid())

  /// Stable, readable identifier (e.g. "business_type", "ideal_client").
  /// Visibility rules and the signal engine reference questions by it —
  /// never by `id`, which changes on every re-seed.
  key String @unique

  text       String
  category   QuestionCategory
  answerType AnswerType

  /// single_choice/multi_choice options: [{ value, label }]. Null for text
  /// types.
  options Json?

  required Boolean @default(false)

  /// Display order. Global across the catalog (the seed assigns it in steps of
  /// 10), which is what makes visibility resolution deterministic.
  order Int

  /// Conditional display rule evaluated by src/core/visibility.ts.
  /// Null = always visible.
  visibilityRule Json?

  /// Helper text shown below the question in the form (pt-BR).
  helpText String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  answers Answer[]

  @@index([category, order])
  @@map("questions")
}

/// A Briefing's answer to a Question.
model Answer {
  id         String   @id @default(cuid())
  briefingId String
  questionId String

  /// String for text types and single_choice; array of strings for
  /// multi_choice. Json unifies both cases without an extra column.
  value Json

  answeredAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  briefing Briefing @relation(fields: [briefingId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  /// Enables the autosave upsert and guarantees one answer per question.
  @@unique([briefingId, questionId])
  @@index([briefingId])
  @@map("answers")
}

/// Warning signal detected from a Briefing's answers.
/// Recreated from scratch on every reprocessing.
model Signal {
  id         String            @id @default(cuid())
  briefingId String
  category   DiagnosisCategory
  severity   SignalSeverity

  /// Signal type identifier (e.g. "vague_goal"). Matches the rule's `code` in
  /// src/core/signals/rules/.
  code String

  description String

  /// Ids of the Answers that fired the signal — traceability in the panel.
  sourceAnswerIds String[]

  createdAt DateTime @default(now())

  briefing Briefing @relation(fields: [briefingId], references: [id], onDelete: Cascade)

  @@unique([briefingId, code])
  @@index([briefingId])
  @@map("signals")
}

/// A Briefing's aggregated result per category.
/// Recreated from scratch on every reprocessing.
model Diagnosis {
  id         String            @id @default(cuid())
  briefingId String
  category   DiagnosisCategory

  /// 0–100. Null when status = gray: the category isn't scored for lack of
  /// required data, and 0 would be indistinguishable from `red`.
  score Int?

  status  DiagnosisStatus
  signalIds String[]

  createdAt DateTime @default(now())

  briefing Briefing @relation(fields: [briefingId], references: [id], onDelete: Cascade)

  @@unique([briefingId, category])
  @@index([briefingId])
  @@map("diagnoses")
}

/// Fixed-window rate-limit counter (SEC-04, decision D2).
///
/// In Postgres, not in memory, because on serverless each instance would have
/// its own counter. One row per key: the window is overwritten when it
/// expires, so the table grows with the number of distinct keys, not requests.
/// The key never holds a clear-text IP — only its hash (see
/// src/server/security/rateLimitRules.ts).
model RateLimitBucket {
  key         String   @id
  windowStart DateTime @map("window_start")
  count       Int

  @@index([windowStart])
  @@map("rate_limit_buckets")
}
